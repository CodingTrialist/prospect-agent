{
  "expo": {
    "name": "Prospect Triage",
    "slug": "prospect-triage",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "prospecttriage",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F3F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.prospecttriage"
    },
    "android": {
      "package": "com.example.prospecttriage",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B5FBF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Prospect Triage",
      "shortName": "Prospects",
      "lang": "en",
      "display": "standalone",
      "startUrl": "/",
      "backgroundColor": "#F2F3F7",
      "themeColor": "#0B5FBF",
      "orientation": "portrait",
      "description": "Review, assign, and act on qualified prospects."
    }
  }
}
